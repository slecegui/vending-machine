    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// Verificamos si la respuesta de nuestra petición principal fue 401\r",
          "if (pm.response.code === 401) {\r",
          "    console.log(\"Detectado error 401. Solicitando nuevo token...\");\r",
          "\r",
          "    // Configuramos la petición interna de Postman hacia el endpoint de login\r",
          "    const loginRequest = {\r",
          "        url: pm.collectionVariables.get(\"base_url\") + '/api/login',\r",
          "        method: 'POST',\r",
          "        header: 'Content-Type: application/json',\r",
          "        body: {\r",
          "            mode: 'raw',\r",
          "            raw: JSON.stringify({\r",
          "                username: \"tech@vending.com\",\r",
          "                password: \"tech123\"\r",
          "            })\r",
          "        }\r",
          "    };\r",
          "\r",
          "    // Enviamos la petición en segundo plano\r",
          "    pm.sendRequest(loginRequest, function (error, response) {\r",
          "        if (error) {\r",
          "            console.error(\"Error al intentar hacer login automático:\", error);\r",
          "        } else {\r",
          "            // Analizamos la respuesta del login\r",
          "            const jsonResponse = response.json();\r",
          "            \r",
          "            // LexikJWTAuthenticationBundle suele devolver el token en la clave \"token\"\r",
          "            if (jsonResponse.token) {\r",
          "                // Guardamos el nuevo token en la variable de la colección\r",
          "                pm.collectionVariables.set(\"bearer_token\", jsonResponse.token);\r",
          "                console.log(\"¡Token actualizado con éxito! Vuelve a enviar tu petición.\");\r",
          "            } else {\r",
          "                console.error(\"El login respondió, pero no se encontró el token en el JSON.\");\r",
          "            }\r",
          "        }\r",
          "    });\r",
          "}"
        ]
      }
    }
